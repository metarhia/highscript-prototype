{
  "name": "highscript-prototype",
  "version": "0.2.0",
  "private": true,
  "description": "Self-similar architectural DSL: specification, platform and PaymentSystem example",
  "license": "MIT",
  "author": "Timur Shemsedinov <timur.shemsedinov@gmail.com>",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "node platform/bin/highscript.js check",
    "scaffold": "node platform/bin/highscript.js scaffold",
    "diagram": "node platform/bin/highscript.js diagram --out Enterprise/docs/architecture.md",
    "start": "node platform/bin/highscript.js up Enterprise",
    "demo": "node platform/bin/highscript.js up Enterprise --scenario Enterprise/test/scenario.js",
    "test": "node --test \"platform/test/*.test.js\" \"Enterprise/**/test/*.test.js\"",
    "lint": "eslint . && prettier -c \"**/*.js\" \"**/*.json\" \"**/*.md\"",
    "fix": "eslint . --fix && prettier --write \"**/*.js\" \"**/*.json\" \"**/*.md\""
  },
  "devDependencies": {
    "eslint": "^9.39.4",
    "eslint-config-metarhia": "^9.1.9",
    "prettier": "^3.8.4"
  }
}
